rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // 1. 출석체크 (attendance) 규칙 - 비로그인 빠른 출석체크 및 조회 허용
    match /attendance/{attendanceId} {
      allow read, write: if true;
    }
    
    // 2. 오늘의 한마디 (social_messages) 규칙
    match /social_messages/{messageId} {
      allow read: if true;
      allow create: if request.auth != null && request.resource.data.user_id == request.auth.uid;
      allow delete: if request.auth != null && (resource.data.user_id == request.auth.uid || request.auth.token.email == 'admin@admin.com');
      allow update: if false;
    }

    // 3. 사용자 정보 (users) 규칙 - 누구나 회원 명단 조회 및 빠른 출석 가능
    match /users/{userId} {
      allow read, write: if true;
    }

    // 4. 클럽 전역 설정 (대표 사진 등) 규칙 - 모바일/웹 모든 기기 실시간 동기화 지원
    match /settings/{settingId} {
      allow read, write: if true;
    }
  }
}

